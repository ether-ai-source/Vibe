<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vibe_bg"
    android:orientation="vertical"
    android:paddingHorizontal="42dp"
    android:paddingTop="26dp"
    android:paddingBottom="18dp">

    <!-- Minimalist Borderless Netflix Top Navigation with Generous Negative Spacing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="38dp"
            android:letterSpacing="0.12"
            android:text="VIBE"
            android:textColor="@color/vibe_netflix_red"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_watch"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="22dp"
            android:stateListAnimator="@null"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_indian"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="22dp"
            android:stateListAnimator="@null"
            android:text="Indian Releases"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_live"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="22dp"
            android:stateListAnimator="@null"
            android:text="Live TV HD"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_search"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tv_focus_button"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:paddingHorizontal="22dp"
            android:stateListAnimator="@null"
            android:text="Search"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_sources"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="22dp"
            android:stateListAnimator="@null"
            android:text="Repos &amp; MegaRepo"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_status_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4K / 1080p Instant Stream"
            android:textColor="@color/vibe_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Intelligent Search Bar (Shown when Search is clicked) -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_search_query"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:background="@drawable/tv_focus_card"
            android:focusable="true"
            android:hint="Search any Indian / Hollywood Movie, Series, Channel, or paste stream URL..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="20dp"
            android:singleLine="true"
            android:textColor="@color/vibe_text_primary"
            android:textColorHint="@color/vibe_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_execute_search"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:stateListAnimator="@null"
            android:text="Search All"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_search"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:stateListAnimator="@null"
            android:text="Reset"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Netflix-Style Hero Banner with Negative Space & Backdrop Image -->
    <FrameLayout
        android:id="@+id/hero_banner_container"
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/tv_focus_card">

        <ImageView
            android:id="@+id/iv_hero_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.55"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_gradient" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="30dp"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hero_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/vibe_netflix_red"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="4K UHD"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hero_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Indian &amp; Global Releases • Instant Play"
                    android:textColor="@color/vibe_emerald"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hero_title"
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tears of Steel"
                android:textColor="@color/vibe_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hero_desc"
                android:layout_width="540dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="Select any title below with your Fire TV remote to watch immediately in 1080p / 4K HD with zero storage bloat."
                android:textColor="@color/vibe_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Row Header -->
    <TextView
        android:id="@+id/tv_row_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.03"
        android:text="Featured &amp; Indian Releases"
        android:textColor="@color/vibe_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Borderless Poster & Backdrop Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_media_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true" />

    <!-- Repositories & MegaRepo Sub-Extension Manager Panel -->
    <LinearLayout
        android:id="@+id/panel_repositories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_repo_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pre-Installed Indian &amp; CloudStream 3 Repositories (Click any repo to open &amp; install extensions)"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_back_to_repos"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="18dp"
                android:stateListAnimator="@null"
                android:text="Back to All Repos"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/repo_input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_repo_url"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/tv_focus_card"
                android:focusable="true"
                android:hint="Type shortcode (megarepo, phisherrepo, cnc, csx, likdev) or repo.json / .m3u URL..."
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/vibe_text_primary"
                android:textColorHint="@color/vibe_text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_add_repo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:stateListAnimator="@null"
                android:text="+ Install Repo"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_repos_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:descendantFocusability="afterDescendants"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
