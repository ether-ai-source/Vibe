<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- High-visibility 4dp bright yellow/gold border when focused on TV -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <stroke android:width="4dp" android:color="#FACC15" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <stroke android:width="3dp" android:color="#818CF8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141C2B" />
            <stroke android:width="1dp" android:color="#26334D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
