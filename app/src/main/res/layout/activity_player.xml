<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Fullscreen Hardware Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Clean Loading Indicator -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/tv_focus_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="22dp">

        <ProgressBar
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tv_buffering_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Starting video..."
            android:textColor="@color/vibe_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Easy-to-Read Senior-Friendly TV Control Bar -->
    <LinearLayout
        android:id="@+id/osd_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D90A0E17"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="24dp">

        <TextView
            android:id="@+id/tv_player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Now Playing"
            android:textColor="@color/vibe_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_player_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Use Left / Right on remote to rewind or fast-forward"
            android:textColor="@color/vibe_text_secondary"
            android:textSize="15sp" />

        <!-- Progress Bar & Large Timestamps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/player_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/vibe_focus_ring" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="LIVE"
                android:textColor="@color/vibe_text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Large Remote Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_osd_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:text="Pause"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_osd_rew"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:text="-10s Back"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_osd_ffwd"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:text="+10s Forward"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_osd_switch_source"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:text="Change Source"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_osd_aspect"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:text="Screen Fit"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
