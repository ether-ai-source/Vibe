<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vibe_bg"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingVertical="24dp">

    <!-- Clean, Senior-Friendly Top Bar: Brand + 3 Simple Big Buttons + Category Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:letterSpacing="0.06"
            android:text="VIBE TV"
            android:textColor="@color/vibe_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_watch"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:nextFocusDown="@+id/btn_cat_all"
            android:paddingHorizontal="24dp"
            android:text="Watch"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_search"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:text="Search"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_nav_sources"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:text="Add Source"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_status_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Press OK on any title to play"
            android:textColor="@color/vibe_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Simple Category Filter Row (Visible on Watch screen) -->
    <LinearLayout
        android:id="@+id/category_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cat_all"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:nextFocusDown="@+id/rv_media_grid"
            android:paddingHorizontal="18dp"
            android:text="All"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_cat_movies"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:nextFocusDown="@+id/rv_media_grid"
            android:paddingHorizontal="18dp"
            android:text="Movies &amp; Shows"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_cat_live"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:nextFocusDown="@+id/rv_media_grid"
            android:paddingHorizontal="18dp"
            android:text="Live TV"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_cat_repos"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:nextFocusDown="@+id/rv_media_grid"
            android:paddingHorizontal="18dp"
            android:text="Added Sources"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Search Bar (Only shown when Search tab is clicked) -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_search_query"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/tv_focus_card"
            android:focusable="true"
            android:hint="Type a movie/channel name or paste a direct video link..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:textColor="@color/vibe_text_primary"
            android:textColorHint="@color/vibe_text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_execute_search"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:text="Search / Play"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_search"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/tv_focus_button"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:text="Clear"
            android:textAllCaps="false"
            android:textColor="@color/vibe_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- SECTION 1: Main Watch Grid (Big, readable 3-column TV cards) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_media_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true" />

    <!-- SECTION 2: Add Source / Repositories Panel -->
    <LinearLayout
        android:id="@+id/panel_repositories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 1-Click Quick-Add Presets (No typing needed on Fire TV remote!) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Quick-Add Popular Sources (One Click with Remote):"
            android:textColor="@color/vibe_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_preset_iptv"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="18dp"
                android:text="+ Free World Live TV (English)"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_preset_movies"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="18dp"
                android:text="+ Public Movie Channels"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_reload_sources"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="18dp"
                android:text="Refresh All Sources"
                android:textAllCaps="false"
                android:textColor="@color/vibe_emerald"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Custom Repo / CloudStream 3 / M3U Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_repo_url"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/tv_focus_card"
                android:focusable="true"
                android:hint="Or enter CloudStream 3 repo URL, owner/repo, or .m3u playlist URL..."
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/vibe_text_primary"
                android:textColorHint="@color/vibe_text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_add_repo"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/tv_focus_button"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:text="+ Add URL"
                android:textAllCaps="false"
                android:textColor="@color/vibe_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_repos_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:descendantFocusability="afterDescendants"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
